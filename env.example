hostname=flutter_ci_runner
pull_policy=always
GRADLE_OPTS=-Xmx2048m -Dorg.gradle.jvmargs=-Xmx2048m -Dorg.gradle.daemon=false -Dorg.gradle.workers.max=2 -Dorg.gradle.caching=true
PLAY_STORE_JSON_PATH="/tmp/secrets/google-play.json"
PACKAGE_NAME="com.tu.empresa.app"
KEYSTORE_PASSWORD="***"
KEY_ALIAS="***"
KEY_PASSWORD="***"

# Ruta en el host donde se guardarán los símbolos de desofuscación
DEBUG_INFO_HOST_PATH="./debug_files"

# Comandos parametrizados
APK_BUILD_CMD='flutter pub get && flutter build apk --release --obfuscate --split-debug-info=/debug-info -v'
AAB_BUILD_CMD='flutter pub get && flutter build appbundle --release --obfuscate --split-debug-info=/debug-info -v'
FASTLANE_CMD='cd android && fastlane supply --track production --aab ../build/app/outputs/bundle/release/app-release.aab --json_key /secrets/play_store_key.json --package_name $PACKAGE_NAME'
